# Copy this file to backend/.env and fill in what you have.
# Anything left blank simply makes that tool run in mock-data mode —
# the system still runs end to end while you collect the rest.

# --- Anthropic (required for the orchestrator itself) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Microsoft Graph: email + calendar (one Azure app covers both) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_USER_EMAIL=ceo@agmc.ae

# --- X (Twitter) API v2 ---
X_BEARER_TOKEN=
X_HANDLE=AGMC

# --- Meta Graph API: Instagram + Facebook ---
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_PAGE_ID=

# --- Ignav Flight Prices API: flight fare search (free account, no card, at ignav.com/signup) ---
IGNAV_API_KEY=
